---
const links = [
	{ href: "#mapa", label: "El mapa" },
	{ href: "#como-jugar", label: "Cómo jugar" },
	{ href: "#versus", label: "Versus" },
	{ href: "#equipos", label: "Equipos" },
	{ href: "#mejoras", label: "Mejoras" },
	{ href: "#tematicas", label: "Temáticas" },
	{ href: "#planes", label: "Planes" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b-2 border-oro-700/40 bg-piedra-950/95 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
		<a href="#inicio" class="flex shrink-0 items-center gap-2 transition-transform hover:scale-105" aria-label="BattleGraph, ir al inicio">
			<img src="/assets/ui/logo.webp" alt="BattleGraph" class="px h-7 w-auto sm:h-9 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" width="320" height="108" />
		</a>

		<nav class="hidden items-center gap-6 lg:flex" aria-label="Secciones">
			{
				links.map((l) => (
					<a
						href={l.href}
						class="text-sm font-bold text-crema-300 transition-colors hover:text-oro-300 hover:drop-shadow-[0_0_8px_rgba(240,207,122,0.6)]"
					>
						{l.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2 sm:gap-3">
			<a
				href="/planes"
				class="hidden text-xs font-bold uppercase tracking-wider text-crema-300 hover:text-oro-300 sm:inline"
			>Crear cuenta</a>
			<button
				type="button"
				data-open-game
				class="pixel-btn !px-3.5 !py-2 sm:!px-5 sm:!py-2.5 !text-xs shadow-[0_0_12px_rgba(230,184,77,0.25)] cursor-pointer"
			>Jugar</button>

			<!-- Botón de Menú Móvil -->
			<button
				id="mobile-menu-btn"
				type="button"
				class="flex h-9 w-9 items-center justify-center rounded border border-piedra-700 bg-piedra-900 text-crema-300 lg:hidden"
				aria-label="Abrir menú"
			>
				<span aria-hidden="true" class="grid w-4 gap-1"><i class="h-0.5 bg-current"></i><i class="h-0.5 bg-current"></i><i class="h-0.5 bg-current"></i></span>
			</button>
		</div>
	</div>

	<!-- Menú Desplegable Móvil -->
	<div id="mobile-menu" class="hidden border-b border-piedra-700 bg-piedra-950/98 px-4 py-4 lg:hidden">
		<nav class="flex flex-col gap-3">
			<a href="/planes" class="mobile-nav-link text-sm font-bold text-oro-300 py-1.5 border-b border-piedra-800/60">Crear cuenta institucional</a>
			{
				links.map((l) => (
					<a
						href={l.href}
						class="mobile-nav-link text-sm font-bold text-crema-300 py-1.5 border-b border-piedra-800/60 hover:text-oro-300"
					>
						{l.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const menuBtn = document.getElementById("mobile-menu-btn");
	const menu = document.getElementById("mobile-menu");
	const navLinks = document.querySelectorAll(".mobile-nav-link");

	menuBtn?.addEventListener("click", () => {
		menu?.classList.toggle("hidden");
	});

	navLinks.forEach((link) => {
		link.addEventListener("click", () => {
			menu?.classList.add("hidden");
		});
	});
</script>

