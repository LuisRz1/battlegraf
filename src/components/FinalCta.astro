---
import { mobileRelease } from "../lib/downloads";

const platforms = [
	{ name: "Web", icon: "WEB", status: "Demo disponible" },
	{ name: "Android", icon: "AND", status: "APK disponible" },
	{ name: "iOS", icon: "IOS", status: "Próximamente" },
];
---

<section id="jugar" class="relative overflow-hidden py-20 sm:py-36">
	<!-- Fondo de Escenario con Viñeta -->
	<div class="absolute inset-0 -z-10" aria-hidden="true">
		<img src="/assets/ui/menu_bg.webp" alt="" class="px h-full w-full object-cover object-bottom filter brightness-75 scale-105" />
		<div class="absolute inset-0 bg-gradient-to-b from-piedra-950 via-piedra-950/70 to-piedra-950" aria-hidden="true"></div>
		<div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_transparent_0%,_#0d0c14_90%)]" aria-hidden="true"></div>
	</div>

	<div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
		<div class="reveal pixel-panel p-6 sm:p-12 flex flex-col items-center gap-6 sm:gap-7 border-2 border-oro-700/60 shadow-[0_0_50px_rgba(230,184,77,0.2)]">
			<div class="relative">
				<img src="/assets/vfx/fx_conquest.webp" alt="" aria-hidden="true" class="px h-12 w-12 sm:h-16 sm:w-16 animate-bounce" width="256" height="32" />
			</div>

			<div class="section-tag justify-center">¿LISTO PARA EL DESAFÍO?</div>

			<h2 class="display text-crema-100">
				La guerra de la trivia
				<br />
				<span class="text-oro-300 drop-shadow-[0_0_15px_rgba(240,207,122,0.5)]">empieza en el mapa</span>
			</h2>

			<p class="max-w-lg text-sm sm:text-base leading-relaxed text-crema-300">
				Forma tu imperio, responde sin miedo y domina la red territorial. ¿Estás listo para reclamar tu primer nodo?
			</p>

			<div class="flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row">
				<button type="button" data-open-game class="pixel-btn w-full sm:w-auto !text-sm sm:!text-lg !px-6 sm:!px-10 !py-3.5 sm:!py-4 shadow-[0_0_25px_rgba(240,207,122,0.4)] cursor-pointer">
					Cargar Demo en Vivo (Web)
				</button>
				<a
					href={mobileRelease.androidUrl}
					download={mobileRelease.androidFileName}
					class="pixel-btn pixel-btn-secondary w-full sm:w-auto !text-sm sm:!text-lg !px-6 sm:!px-10 !py-3.5 sm:!py-4"
					aria-describedby="android-download-details"
				>
					Descargar App Android
				</a>
			</div>

			<p id="android-download-details" class="max-w-xl text-xs leading-relaxed text-crema-400 sm:text-sm">
				Versión piloto {mobileRelease.version} · APK universal · {mobileRelease.androidSize}. La versión para iOS se distribuirá mediante TestFlight cuando esté firmada.
			</p>

			<!-- Badges de Plataformas Disponibles -->
			<div class="mt-2 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
				<span class="text-xs uppercase tracking-widest text-crema-500 font-bold">DISPONIBLE EN:</span>
				{
					platforms.map((p) => (
						<span class="game-badge !py-1 !px-2.5 sm:!px-3 font-bold border-oro-700/50" title={p.status}>
							<span>{p.icon}</span> {p.name} · {p.status}
						</span>
					))
				}
			</div>

			<div class="pt-4 border-t border-piedra-700/60 w-full text-[0.7rem] sm:text-xs text-crema-500 flex flex-col sm:flex-row items-center justify-between gap-2">
				<span>MOTOR DE JUEGO: GODOT 4</span>
				<span>ARTE PIXEL MEDIEVAL 16-BIT</span>
			</div>
		</div>
	</div>
</section>

