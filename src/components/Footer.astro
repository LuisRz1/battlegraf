---
const links = [
	{ href: "#mapa", label: "El mapa" },
	{ href: "#como-jugar", label: "Cómo jugar" },
	{ href: "#versus", label: "Versus" },
	{ href: "#equipos", label: "Equipos" },
	{ href: "#mejoras", label: "Mejoras" },
	{ href: "#tematicas", label: "Temáticas" },
];
---

<footer class="border-t-2 border-oro-700/40 bg-piedra-950 py-10">
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 sm:px-6 md:flex-row md:justify-between">
		<a href="#inicio" class="flex items-center gap-3" aria-label="BattleGraph, ir al inicio">
			<img src="/assets/ui/logo.png" alt="BattleGraph" class="px h-7 w-auto" width="320" height="108" />
		</a>

		<nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2" aria-label="Secciones del pie">
			{
				links.map((l) => (
					<a href={l.href} class="text-xs font-bold text-crema-300 transition-colors hover:text-oro-300">
						{l.label}
					</a>
				))
			}
		</nav>

		<p class="text-center text-xs text-crema-500 md:text-right">
			© {new Date().getFullYear()} BattleGraph
			<br />
			Desarrollado con Godot 4 · Jolt Physics
		</p>
	</div>
</footer>

