---
import PortalLayout from "../layouts/PortalLayout.astro";
import { getPlan } from "../lib/plans";
import { createSupabaseServerClient, hasSupabaseConfig } from "../lib/supabase";

if (!hasSupabaseConfig()) return Astro.redirect("/registro?error=config");

const supabase = createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies });
const { data: userData } = await supabase.auth.getUser();
if (!userData.user) return Astro.redirect("/iniciar-sesion");

const { data: membership } = await supabase
	.from("memberships")
	.select("school_id, role, schools(id, name, code, region, city, onboarding_complete)")
	.eq("user_id", userData.user.id)
	.limit(1)
	.maybeSingle();

if (!membership) return Astro.redirect("/registro?error=no_institution");

const schoolId = membership.school_id;
const [subscriptionResult, studentsResult, sectionsResult, subjectsResult, clansResult, materialsResult, questionsResult] = await Promise.all([
	supabase.from("subscriptions").select("plan_slug, status, student_limit, ai_credits_monthly, trial_plan_slug, trial_started_at, trial_ends_at").eq("school_id", schoolId).maybeSingle(),
	supabase.from("student_profiles").select("id, full_name, email, section_id, is_demo", { count: "exact" }).eq("school_id", schoolId).order("created_at").limit(10),
	supabase.from("sections").select("id, display_name, code, tutor_name, is_demo").eq("school_id", schoolId).eq("status", "active").order("display_name"),
	supabase.from("subjects").select("id, name, color, icon_code, is_demo").eq("school_id", schoolId).eq("is_enabled", true).order("name"),
	supabase.from("clans").select("id", { count: "exact", head: true }).eq("school_id", schoolId),
	supabase.from("learning_materials").select("id, title, file_name, file_type, processing_status, is_demo, subjects(name)").eq("school_id", schoolId).order("created_at", { ascending: false }).limit(8),
	supabase.from("question_bank").select("id", { count: "exact", head: true }).eq("school_id", schoolId),
]);

const schoolRecord = Array.isArray(membership.schools) ? membership.schools[0] : membership.schools;
const school = schoolRecord as { name?: string; code?: string; region?: string; city?: string; onboarding_complete?: boolean } | null | undefined;
const subscription = subscriptionResult.data;
const basePlan = getPlan(subscription?.plan_slug);
const trialEnd = subscription?.trial_ends_at ? new Date(subscription.trial_ends_at) : null;
const trialActive = Boolean(subscription?.status === "trialing" && trialEnd && trialEnd.getTime() > Date.now());
const effectivePlan = trialActive ? getPlan(subscription?.trial_plan_slug ?? "red") : basePlan;
const trialDaysLeft = trialEnd ? Math.max(0, Math.ceil((trialEnd.getTime() - Date.now()) / 86_400_000)) : 0;
const students = studentsResult.data ?? [];
const sections = sectionsResult.data ?? [];
const subjects = subjectsResult.data ?? [];
const materials = materialsResult.data ?? [];
const studentCount = studentsResult.count ?? students.length;
const clanCount = clansResult.count ?? 0;
const questionCount = questionsResult.count ?? 0;
const percentage = Math.min(100, Math.round((studentCount / effectivePlan.studentLimit) * 100));
const welcome = Astro.url.searchParams.has("welcome");
const login = Astro.url.searchParams.has("login");
const saved = Astro.url.searchParams.has("saved");
const created = Astro.url.searchParams.get("created");
const hasError = Astro.url.searchParams.has("error");
const createdLabels: Record<string, string> = {
	section: "Sección creada con materias y clanes iniciales.",
	subject: "Materia creada y asignada a las secciones activas.",
	student: "Alumno añadido a la institución.",
	material: "Material registrado y preguntas de muestra generadas para revisión.",
	question: "Pregunta manual añadida al banco y lista para usar.",
};
const errorCode = Astro.url.searchParams.get("error");
---

<PortalLayout
	title="Panel institucional | BattleGraph"
	description="Configure su institución, secciones, personas y capacidades en BattleGraph."
>
	<section class="panel-shell">
		<aside class="panel-sidebar">
			<div class="panel-user">
				<img src={userData.user.user_metadata.avatar_url ?? "/assets/ui/icon_app_512.webp"} alt="" referrerpolicy="no-referrer" />
				<div><strong>{userData.user.user_metadata.full_name ?? "Administrador"}</strong><span>{membership.role}</span></div>
			</div>
			<nav aria-label="Panel institucional">
				<a class="active" href="/panel"><span>01</span> Resumen</a>
				<a href="/panel#estructura"><span>02</span> Secciones</a>
				<a href="/panel#personas"><span>03</span> Personas</a>
				<a href="/panel#contenido"><span>04</span> Contenido</a>
				<a href="/panel#ia"><span>05</span> IA pedagógica</a>
			</nav>
			<form method="post" action="/auth/logout"><button class="portal-link" type="submit">Cerrar sesión</button></form>
		</aside>

		<div class="panel-content">
			<header class="panel-header">
				<div><span>CUARTEL INSTITUCIONAL</span><h1>{school?.name ?? "Institución BattleGraph"}</h1></div>
				<a class="pixel-btn !text-xs !px-4 !py-2" href="/planes">Gestionar plan</a>
			</header>

			{trialActive && (
				<div class="trial-banner">
					<div><span>PRUEBA DE NIVEL MÁXIMO</span><strong>{trialDaysLeft} {trialDaysLeft === 1 ? "día restante" : "días restantes"}</strong></div>
					<p>Todas las funciones de Red Educativa están habilitadas. Al finalizar, tu cuenta continuará automáticamente en Explorador con 30 alumnos y operación manual.</p>
					<a href="/planes">Comparar planes</a>
				</div>
			)}

			{(welcome || login || saved || created || hasError) && (
				<div class:list={["panel-notice", hasError && "error"]}>
					{hasError
						? errorCode === "upgrade" ? "La carga con IA terminó con la prueba. Puedes añadir preguntas manualmente o elegir un plan superior." : "No pudimos guardar ese cambio. Revisa los datos e inténtalo nuevamente."
						: created
							? createdLabels[created]
							: saved
								? "Configuración institucional guardada."
								: login
									? "Sesión iniciada. Tu institución y la fecha de prueba se conservaron."
									: "Cuenta creada. Preparamos automáticamente una institución demostrativa completa y editable."}
				</div>
			)}

			<div class="panel-metrics panel-metrics-four">
				<article><span>ACCESO ACTUAL</span><strong>{effectivePlan.name}</strong><small>{trialActive ? `Prueba; luego ${basePlan.name}` : basePlan.name}</small></article>
				<article><span>ESTUDIANTES</span><strong>{studentCount} / {effectivePlan.studentLimit.toLocaleString("es-PE")}</strong><div class="meter"><i style={`width:${percentage}%`}></i></div></article>
				<article><span>PREGUNTAS</span><strong>{questionCount}</strong><small>{questionCount > 0 ? "Banco listo para probar" : "Añade contenido"}</small></article>
				<article><span>IA DISPONIBLE</span><strong>{effectivePlan.aiCredits === 0 ? "Manual" : `${effectivePlan.aiCredits.toLocaleString("es-PE")} acciones`}</strong><small>{trialActive ? "Incluida durante la prueba" : "Cuota mensual"}</small></article>
			</div>

			<section class="panel-module setup-summary" id="configuracion">
				<div class="module-title"><span>CONFIGURACIÓN AUTOMÁTICA</span><h2>Tu colegio ya puede probarse</h2><p>Estos datos son demostrativos y están marcados para que puedas reconocerlos. Puedes editarlos o crear información real con los controles clásicos.</p></div>
				<div class="setup-track">
					<div><b>01</b><strong>Institución</strong><span>Código {school?.code ?? "generado"}</span></div>
					<div><b>02</b><strong>{sections.length} secciones</strong><span>Materias asignadas</span></div>
					<div><b>03</b><strong>{clanCount} clanes</strong><span>Rojo y morado</span></div>
					<div><b>04</b><strong>{studentCount} alumnos</strong><span>Perfiles de muestra</span></div>
					<div><b>05</b><strong>{questionCount} preguntas</strong><span>Listas para revisión</span></div>
				</div>
				<form class="institution-form" method="post" action="/api/institucion">
					<label>Nombre oficial<input name="name" required minlength="3" maxlength="120" value={school?.name ?? ""} /></label>
					<label>Código institucional<input name="code" required minlength="3" maxlength="30" value={school?.code ?? ""} /></label>
					<label>Región<input name="region" maxlength="80" value={school?.region ?? ""} placeholder="Lima" /></label>
					<label>Ciudad o distrito<input name="city" maxlength="80" value={school?.city ?? ""} placeholder="Distrito" /></label>
					<button class="pixel-btn" type="submit">Guardar institución</button>
				</form>
			</section>

			<section class="panel-module" id="estructura">
				<div class="module-heading-row">
					<div class="module-title"><span>ESTRUCTURA ACADÉMICA</span><h2>Secciones, materias y clanes</h2><p>Cada sección nueva recibe las materias activas y dos clanes iniciales para que pueda jugar inmediatamente.</p></div>
					<div class="module-actions"><button class="pixel-btn pixel-btn-secondary" type="button" data-open-dialog="section-dialog">Nueva sección</button><button class="pixel-btn pixel-btn-secondary" type="button" data-open-dialog="subject-dialog">Nueva materia</button></div>
				</div>
				<div class="resource-grid">
					<div class="resource-column"><h3>Secciones ({sections.length})</h3>{sections.map((section) => <article class="resource-row"><div><strong>{section.display_name}</strong><span>{section.code} · {section.tutor_name}</span></div>{section.is_demo && <i>DEMO</i>}</article>)}</div>
					<div class="resource-column"><h3>Materias ({subjects.length})</h3>{subjects.map((subject) => <article class="resource-row"><span class="subject-swatch" style={`--subject:${subject.color}`}>{subject.icon_code}</span><div><strong>{subject.name}</strong><span>Asignada a secciones activas</span></div>{subject.is_demo && <i>DEMO</i>}</article>)}</div>
				</div>
			</section>

			<section class="panel-module" id="personas">
				<div class="module-heading-row">
					<div class="module-title"><span>PERSONAS Y PERMISOS</span><h2>Alumnos y equipo académico</h2><p>Los perfiles demostrativos permiten recorrer el sistema; los nuevos perfiles se guardan como datos reales de tu institución.</p></div>
					<button class="pixel-btn pixel-btn-secondary" type="button" data-open-dialog="student-dialog">Añadir alumno</button>
				</div>
				<div class="role-chips"><span>Director</span><span>Subdirector</span><span>Coordinador</span><span>Tutor</span><span>Profesor</span><span>Estudiante</span></div>
				<div class="student-list">{students.map((student) => <article><div><strong>{student.full_name}</strong><span>{student.email ?? "Perfil administrado por el colegio"}</span></div>{student.is_demo && <i>DEMO</i>}</article>)}</div>
			</section>

			<section class="panel-module" id="contenido">
				<div class="module-heading-row">
					<div class="module-title"><span>CONTENIDO Y PREGUNTAS</span><h2>Materiales del colegio</h2><p>Registra PDF, PPTX, DOCX o imágenes. En este prototipo el archivo genera preguntas de muestra para que el docente revise el flujo completo.</p></div>
						<div class="module-actions">
							<button class="pixel-btn pixel-btn-secondary" type="button" data-open-dialog="question-dialog">Añadir pregunta</button>
							{effectivePlan.aiCredits > 0 ? <button class="pixel-btn pixel-btn-secondary" type="button" data-open-dialog="material-dialog">Subir material</button> : <a class="pixel-btn pixel-btn-secondary" href="/planes">Habilitar archivos</a>}
						</div>
				</div>
				<div class="material-list">{materials.map((material) => {
					const materialSubject = Array.isArray(material.subjects) ? material.subjects[0] : material.subjects;
					return <article><b>{String(material.file_type).toUpperCase()}</b><div><strong>{material.title}</strong><span>{materialSubject?.name ?? "Sin materia"} · {material.file_name ?? "Registro manual"}</span></div><i>{material.is_demo ? "DEMO" : material.processing_status}</i></article>;
				})}</div>
			</section>

			<section class="panel-module" id="ia">
				<div class="module-title"><span>IA PEDAGÓGICA</span><h2>Asistentes y recomendaciones</h2><p>Generación de preguntas y clases, revisión de respuestas, resúmenes posbatalla, apoyo al profesor y acompañamiento adaptativo para alumnos, incluido el modo de concentración TDAH.</p></div>
				<div class:list={["ai-lock", effectivePlan.aiCredits > 0 && "unlocked"]}><strong>{effectivePlan.aiCredits > 0 ? "Módulo habilitado" : "Módulo bloqueado"}</strong><span>{trialActive ? `Disponible por ${trialDaysLeft} días con el nivel Red Educativa.` : effectivePlan.aiCredits > 0 ? "Disponible según la cuota del plan." : "El plan Explorador funciona manualmente después de la prueba."}</span></div>
				<div class="ai-feature-grid"><span>Preguntas desde archivos</span><span>Clases personalizadas</span><span>Resumen posbatalla</span><span>Chatbot docente y alumno</span><span>Recomendaciones por errores</span><span>Apoyo de concentración TDAH</span></div>
			</section>
		</div>
	</section>

	<dialog class="portal-dialog" id="section-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="section" /><header><div><span>NUEVA ESTRUCTURA</span><h2>Crear sección</h2></div><button type="button" data-close-dialog aria-label="Cerrar">X</button></header><label>Nivel<select name="level"><option>Primaria</option><option>Secundaria</option></select></label><label>Grado<input name="grade" required placeholder="5" maxlength="12" /></label><label>Sección<input name="section_label" required placeholder="A" maxlength="8" /></label><label>Tutor<input name="tutor_name" placeholder="Nombre del tutor" maxlength="100" /></label><button class="pixel-btn" type="submit">Crear y configurar</button></form></dialog>

	<dialog class="portal-dialog" id="subject-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="subject" /><header><div><span>NUEVO NODO</span><h2>Crear materia</h2></div><button type="button" data-close-dialog aria-label="Cerrar">X</button></header><label>Nombre<input name="name" required placeholder="Inglés" maxlength="80" /></label><label>Código de 3 letras<input name="icon_code" required placeholder="ING" maxlength="3" /></label><label>Color del nodo<input name="color" type="color" value="#e6b84d" /></label><button class="pixel-btn" type="submit">Crear y asignar</button></form></dialog>

	<dialog class="portal-dialog" id="student-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="student" /><header><div><span>NUEVO PERFIL</span><h2>Añadir alumno</h2></div><button type="button" data-close-dialog aria-label="Cerrar">X</button></header><label>Nombre completo<input name="full_name" required maxlength="120" /></label><label>Correo opcional<input name="email" type="email" maxlength="160" /></label><label>Sección<select name="section_id" required><option value="">Selecciona una sección</option>{sections.map((section) => <option value={section.id}>{section.display_name}</option>)}</select></label><label class="check-label"><input name="focus_mode" type="checkbox" /> Activar modo de concentración</label><button class="pixel-btn" type="submit">Añadir alumno</button></form></dialog>

	<dialog class="portal-dialog" id="material-dialog"><form method="post" action="/api/recursos" enctype="multipart/form-data"><input type="hidden" name="action" value="material" /><header><div><span>NUEVO CONTENIDO</span><h2>Subir material</h2></div><button type="button" data-close-dialog aria-label="Cerrar">X</button></header><label>Título<input name="title" required maxlength="120" /></label><label>Materia<select name="subject_id" required><option value="">Selecciona una materia</option>{subjects.map((subject) => <option value={subject.id}>{subject.name}</option>)}</select></label><label>Archivo de demostración<input name="file" type="file" accept=".pdf,.ppt,.pptx,.doc,.docx,.png,.jpg,.jpeg,.webp" /></label><small>El prototipo registra el archivo y crea preguntas de ejemplo; el almacenamiento definitivo se conectará al módulo documental.</small><button class="pixel-btn" type="submit">Procesar material</button></form></dialog>

	<dialog class="portal-dialog" id="question-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="question" /><header><div><span>BANCO MANUAL</span><h2>Añadir pregunta</h2></div><button type="button" data-close-dialog aria-label="Cerrar">X</button></header><label>Materia<select name="subject_id" required><option value="">Selecciona una materia</option>{subjects.map((subject) => <option value={subject.id}>{subject.name}</option>)}</select></label><label>Pregunta<input name="question" required minlength="8" maxlength="300" /></label><label>Opción A<input name="option_0" required maxlength="160" /></label><label>Opción B<input name="option_1" required maxlength="160" /></label><label>Opción C<input name="option_2" required maxlength="160" /></label><label>Opción D<input name="option_3" required maxlength="160" /></label><label>Respuesta correcta<select name="correct_index" required><option value="0">Opción A</option><option value="1">Opción B</option><option value="2">Opción C</option><option value="3">Opción D</option></select></label><button class="pixel-btn" type="submit">Guardar pregunta</button></form></dialog>
</PortalLayout>

<script>
	document.querySelectorAll<HTMLElement>("[data-open-dialog]").forEach((button) => {
		button.addEventListener("click", () => {
			const dialog = document.getElementById(button.dataset.openDialog ?? "") as HTMLDialogElement | null;
			dialog?.showModal();
		});
	});
	document.querySelectorAll<HTMLButtonElement>("[data-close-dialog]").forEach((button) => {
		button.addEventListener("click", () => button.closest("dialog")?.close());
	});
	document.querySelectorAll<HTMLDialogElement>("dialog").forEach((dialog) => {
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) dialog.close();
		});
	});
</script>
