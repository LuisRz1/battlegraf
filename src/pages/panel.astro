---
import PortalLayout from "../layouts/PortalLayout.astro";
import { getPlan } from "../lib/plans";
import { createSupabaseServerClient, hasSupabaseConfig } from "../lib/supabase";

if (!hasSupabaseConfig()) return Astro.redirect("/registro?error=config");
const supabase = createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies });
const { data: userData } = await supabase.auth.getUser();
if (!userData.user) return Astro.redirect("/iniciar-sesion");
const { data: membership } = await supabase.from("memberships").select("school_id, role, schools(id, name, code, region, city, ugel, address, onboarding_complete)").eq("user_id", userData.user.id).limit(1).maybeSingle();
if (!membership) return Astro.redirect("/registro?error=no_institution");
const schoolId = membership.school_id;
const [subscriptionResult, studentsResult, sectionsResult, subjectsResult, clansResult, materialsResult, questionsResult, staffResult, assignmentsResult, battlesResult, ranksResult, auditResult, settingsResult] = await Promise.all([
	supabase.from("subscriptions").select("plan_slug, status, student_limit, ai_credits_monthly, trial_plan_slug, trial_started_at, trial_ends_at").eq("school_id", schoolId).maybeSingle(),
	supabase.from("student_profiles").select("id, full_name, email, section_id, status, is_demo", { count: "exact" }).eq("school_id", schoolId).order("created_at"),
	supabase.from("sections").select("id, display_name, code, level, grade, section_label, tutor_name, status, is_demo").eq("school_id", schoolId).order("display_name"),
	supabase.from("subjects").select("id, name, color, icon_code, is_demo").eq("school_id", schoolId).eq("is_enabled", true).order("name"),
	supabase.from("clans").select("id, name, color, rank_name, section_id, is_demo").eq("school_id", schoolId).order("created_at"),
	supabase.from("learning_materials").select("id, title, file_name, file_type, processing_status, is_demo, subjects(name)").eq("school_id", schoolId).order("created_at", { ascending: false }),
	supabase.from("question_bank").select("id, question, options, status, source, is_demo, subjects(name)", { count: "exact" }).eq("school_id", schoolId).order("created_at", { ascending: false }),
	supabase.from("staff_profiles").select("id, full_name, email, role, scope_label, status, is_demo").eq("school_id", schoolId).order("created_at"),
	supabase.from("assignments").select("id, title, delivery_type, due_at, xp_reward, status, is_demo, sections(display_name), subjects(name)").eq("school_id", schoolId).order("due_at"),
	supabase.from("battle_events").select("id, title, battle_type, opponent_a, opponent_b, scheduled_at, status, graph_layers, nodes_per_layer, is_demo").eq("school_id", schoolId).order("scheduled_at"),
	supabase.from("rank_definitions").select("id, name, min_xp, position, is_demo").eq("school_id", schoolId).order("position"),
	supabase.from("audit_logs").select("id, actor_name, action, target_label, category, created_at").eq("school_id", schoolId).order("created_at", { ascending: false }).limit(30),
	supabase.from("school_settings").select("battle_rules, rank_rules, ai_preferences, accessibility").eq("school_id", schoolId).maybeSingle(),
]);
const schoolRaw = Array.isArray(membership.schools) ? membership.schools[0] : membership.schools;
const school = (schoolRaw ?? {}) as any;
const subscription = subscriptionResult.data;
const basePlan = getPlan(subscription?.plan_slug);
const trialEnd = subscription?.trial_ends_at ? new Date(subscription.trial_ends_at) : null;
const trialActive = Boolean(subscription?.status === "trialing" && trialEnd && trialEnd.getTime() > Date.now());
const effectivePlan = trialActive ? getPlan(subscription?.trial_plan_slug ?? "red") : basePlan;
const trialDaysLeft = trialEnd ? Math.max(0, Math.ceil((trialEnd.getTime() - Date.now()) / 86_400_000)) : 0;
const students = (studentsResult.data ?? []) as any[];
const sections = (sectionsResult.data ?? []) as any[];
const subjects = (subjectsResult.data ?? []) as any[];
const clans = (clansResult.data ?? []) as any[];
const materials = (materialsResult.data ?? []) as any[];
const questions = (questionsResult.data ?? []) as any[];
const staff = (staffResult.data ?? []) as any[];
const assignments = (assignmentsResult.data ?? []) as any[];
const battles = (battlesResult.data ?? []) as any[];
const ranks = (ranksResult.data ?? []) as any[];
const audits = (auditResult.data ?? []) as any[];
const settings = (settingsResult.data ?? {}) as any;
const battleRules = settings.battle_rules ?? {};
const studentCount = studentsResult.count ?? students.length;
const questionCount = questionsResult.count ?? questions.length;
const approvedCount = questions.filter((q) => q.status === "approved").length;
const reviewCount = questions.filter((q) => q.status === "review" || q.status === "draft").length;
const liveBattle = battles.find((battle) => battle.status === "live");
const completion = Math.min(100, Math.round(([school.name, school.code, sections.length, subjects.length, staff.length, materials.length, questions.length, assignments.length, battles.length].filter(Boolean).length / 9) * 100));
const views = [["centro","Centro de mando"],["colegio","Entidad colegio"],["secciones","Secciones y aulas"],["materias","Cursos y materias"],["personas","Usuarios y permisos"],["materiales","Materiales e IA"],["preguntas","Banco de preguntas"],["tareas","Tareas"],["batallas","Batallas y torneos"],["progreso","Rangos, clanes y XP"],["auditoria","Actividad y auditoria"]];
const requestedView = Astro.url.searchParams.get("view") ?? "centro";
const view = views.some(([slug]) => slug === requestedView) ? requestedView : "centro";
const viewTitle = views.find(([slug]) => slug === view)?.[1] ?? "Centro de mando";
const created = Astro.url.searchParams.get("created");
const hasError = Astro.url.searchParams.has("error");
const messages: Record<string,string> = { section:"Seccion creada con materias y clanes.",subject:"Materia creada y asignada.",student:"Alumno agregado.",staff:"Invitacion creada.",material:"Material procesado y preguntas generadas.",question:"Pregunta guardada.",approval:"Pregunta aprobada.",assignment:"Tarea programada.",battle:"Batalla programada.",rank:"Rango creado." };
const fmtDate = (value?: string) => value ? new Intl.DateTimeFormat("es-PE", { day:"2-digit", month:"short", hour:"2-digit", minute:"2-digit" }).format(new Date(value)) : "Sin fecha";
const relationName = (value:any) => Array.isArray(value) ? value[0]?.name ?? value[0]?.display_name : value?.name ?? value?.display_name;
---

<PortalLayout console title={`${viewTitle} | BattleGraph`} description="Centro de mando institucional de BattleGraph.">
<section class="command-shell">
	<aside class="command-sidebar">
		<a class="command-logo" href="/"><img src="/assets/ui/logo.webp" alt="BattleGraph" width="320" height="108" /></a>
		<div class="entity-card"><span>ENTIDAD ACTIVA</span><strong>{school.name ?? "Institucion BattleGraph"}</strong><small>Codigo {school.code ?? "por configurar"}</small></div>
		<span class="command-nav-label">NAVEGACION</span><nav aria-label="Centro de mando">{views.map(([slug,label],index) => <a class:list={[view===slug&&"active"]} href={`/panel?view=${slug}`}><b>{String(index+1).padStart(2,"0")}</b>{label}</a>)}</nav>
		<div class="config-meter"><span>CONFIGURACION</span><strong>{completion}% LISTO</strong><i><b style={`width:${completion}%`}></b></i></div>
		<form method="post" action="/auth/logout"><button class="command-logout" type="submit">CERRAR SESION</button></form>
	</aside>
	<div class="command-stage">
		<header class="command-topbar"><div><span>CONSOLA / {viewTitle.toUpperCase()}</span><strong>{viewTitle}</strong></div><label class="command-search"><span>BUSCAR</span><input id="command-search" placeholder="Alumno, seccion, material..." /></label><label class="role-view"><span>VISTA DE ROL</span><select id="role-view"><option>Director</option><option>Subdirector</option><option>Tutor de aula</option><option>Profesor</option><option>Alumno</option></select></label><div class="command-avatar"><img src={userData.user.user_metadata.avatar_url ?? "/assets/ui/icon_app_512.webp"} alt="" referrerpolicy="no-referrer" /><span>{(userData.user.user_metadata.full_name ?? "DI").slice(0,2).toUpperCase()}</span></div></header>
		{trialActive && <div class="command-trial"><span>PRUEBA RED EDUCATIVA</span><strong>{trialDaysLeft} DIAS RESTANTES</strong><p>Todos los modulos de IA y hasta {effectivePlan.studentLimit.toLocaleString("es-PE")} alumnos estan habilitados. Despues continuaras en Explorador.</p><a href="/planes">VER PLANES</a></div>}
		{(created||hasError||Astro.url.searchParams.has("saved")) && <div class:list={["command-notice",hasError&&"error"]}>{hasError?"No pudimos guardar el cambio. Revisa los datos.":created?messages[created]??"Cambio guardado.":"Configuracion guardada."}</div>}
		<main class="command-content">
		{view === "centro" && <><div class="command-title"><div><span>ESTADO GENERAL</span><h1>BIENVENIDO, DIRECTOR</h1><p>Control institucional, academico y ludico desde una sola consola.</p></div><a class="command-btn" href="/panel?view=colegio">CONTINUAR CONFIGURACION</a></div><div class="metric-grid"><article><span>01 / ESTUDIANTES</span><strong>{studentCount.toString().padStart(2,"0")}</strong><small>{effectivePlan.studentLimit-studentCount} cupos disponibles</small></article><article><span>02 / SECCIONES</span><strong>{sections.length.toString().padStart(2,"0")}</strong><small>{sections.filter(s=>s.status==="active").length} activas</small></article><article><span>03 / PREGUNTAS</span><strong>{questionCount}</strong><small>{reviewCount} por revisar</small></article><article><span>04 / BATALLAS</span><strong>{battles.length.toString().padStart(2,"0")}</strong><small>{battles.filter(b=>b.status==="scheduled").length} programadas</small></article></div><div class="dashboard-grid"><section class="game-panel chart-panel"><span>ACTIVIDAD</span><h2>RITMO DE APRENDIZAJE</h2><div class="pixel-chart">{[42,66,54,78,62,88,72,94].map((height,i)=><i style={`--h:${height}%`}><b>{i+1}</b></i>)}</div></section><section class="game-panel action-panel"><span>ACCIONES</span><h2>SIGUIENTE MOVIMIENTO</h2><a href="/panel?view=personas"><b>03</b><strong>Completar directorio<small>{staff.length} miembros</small></strong><i>IR</i></a><a href="/panel?view=preguntas"><b>07</b><strong>Revisar {reviewCount} preguntas<small>Borrador IA</small></strong><i>IR</i></a><a href="/panel?view=tareas"><b>08</b><strong>Publicar tarea<small>{assignments.length} creadas</small></strong><i>IR</i></a></section><section class="game-panel school-map"><span>COBERTURA</span><h2>MAPA DEL COLEGIO</h2><div>{sections.slice(0,4).map((section,i)=><a href="/panel?view=secciones" style={`--x:${18+(i%2)*55}%;--y:${25+Math.floor(i/2)*48}%`}><i class="node-sprite"></i><b>{section.section_label}</b><small>{section.grade}</small></a>)}</div></section><section class="game-panel activity-mini"><span>EN VIVO</span><h2>ULTIMA ACTIVIDAD</h2>{audits.slice(0,4).map(log=><div><strong>{log.actor_name}</strong><p>{log.action}</p><small>{fmtDate(log.created_at)}</small></div>)}</section></div></>}

		{view === "colegio" && <><div class="command-title"><div><span>NUCLEO INSTITUCIONAL</span><h1>ENTIDAD COLEGIO</h1><p>Datos maestros, reglas academicas y parametros generales.</p></div></div><form class="institution-command-form" method="post" action="/api/institucion"><section class="game-panel"><span>IDENTIDAD</span><h2>DATOS DEL COLEGIO</h2><label>Nombre<input name="name" required value={school.name??""}/></label><label>Codigo del colegio (para que alumnos y docentes se unan)<input name="code" required value={school.code??""} placeholder="BG-7A2K"/></label><label>UGEL<input name="ugel" value={school.ugel??""} placeholder="UGEL 07"/></label><label>Region<input name="region" value={school.region??""}/></label><label>Ciudad o distrito<input name="city" value={school.city??""}/></label><label>Direccion<input name="address" value={school.address??""}/></label></section><section class="game-panel rules-panel"><span>REGLAS</span><h2>CONFIGURACION DE JUEGO</h2><label><input type="checkbox" name="cross_section_battles" checked={battleRules.cross_section_battles!==false}/><strong>Batallas entre secciones<small>Permitir A contra B</small></strong></label><label><input type="checkbox" name="task_progress" checked={battleRules.task_progress!==false}/><strong>Progreso por tareas<small>Las entregas otorgan XP</small></strong></label><label><input type="checkbox" name="review_required" checked={battleRules.review_required!==false}/><strong>Revision docente obligatoria<small>La IA no publica sola</small></strong></label><label>Segundos por turno<input type="number" name="turn_seconds" min="10" max="120" value={battleRules.turn_seconds??30}/></label><button class="command-btn" type="submit">GUARDAR CAMBIOS</button></section></form></>}

		{view === "secciones" && <><div class="command-title"><div><span>ESTRUCTURA ACADEMICA</span><h1>SECCIONES Y AULAS</h1><p>Cada seccion es un territorio con estudiantes, tutor, materias y clanes.</p></div><button class="command-btn" data-open-dialog="section-dialog">CREAR SECCION</button></div><div class="card-grid">{sections.map((section,i)=><article class="territory-card searchable"><span>SECCION {String(i+1).padStart(2,"0")}</span><i>{section.status}</i><div class="section-glyph">{section.section_label}</div><h2>{section.grade}. {section.level}</h2><p>Seccion {section.section_label}</p><dl><div><dt>ESTUDIANTES</dt><dd>{students.filter(s=>s.section_id===section.id).length}</dd></div><div><dt>TUTOR</dt><dd>{section.tutor_name??"Sin asignar"}</dd></div><div><dt>CLANES</dt><dd>{clans.filter(c=>c.section_id===section.id).length}</dd></div></dl><button data-detail-title={section.display_name} data-detail-body={`Codigo ${section.code}. Alumnos y clanes configurados.`}>ABRIR SECCION</button></article>)}</div></>}

		{view === "materias" && <><div class="command-title"><div><span>NODOS DEL CONOCIMIENTO</span><h1>CURSOS Y MATERIAS</h1><p>Cada color identifica una materia en el grafo.</p></div><button class="command-btn" data-open-dialog="subject-dialog">ANADIR MATERIA</button></div><div class="card-grid subject-grid">{subjects.map(subject=><article class="subject-card searchable" style={`--subject:${subject.color}`}><div class="subject-icon"><i class="node-sprite"></i><b>{subject.icon_code}</b></div><span>MATERIA ACTIVA</span><h2>{subject.name}</h2><p>{staff.find(p=>p.scope_label?.includes(subject.name))?.full_name??"Docente por asignar"}</p><dl><div><dt>BANCO</dt><dd>{questions.filter(q=>relationName(q.subjects)===subject.name).length} preguntas</dd></div><div><dt>SECCIONES</dt><dd>{sections.length} asignadas</dd></div></dl><button data-detail-title={subject.name} data-detail-body={`Banco y asignaciones de ${subject.name}.`}>CONFIGURAR</button></article>)}</div></>}

		{view === "personas" && <><div class="command-title"><div><span>IDENTIDADES Y ACCESO</span><h1>USUARIOS Y PERMISOS</h1><p>Crea credenciales, asigna alcance y controla cada rol.</p></div><div class="command-actions"><button class="command-btn ghost" data-open-dialog="import-dialog">IMPORTAR CSV</button><button class="command-btn" data-open-dialog="person-dialog">NUEVO USUARIO</button></div></div><div class="role-counts"><div><b>01</b><strong>Direccion</strong><span>{staff.filter(p=>["director","subdirector"].includes(p.role)).length+1}</span></div><div><b>02</b><strong>Coordinador</strong><span>{staff.filter(p=>p.role==="coordinator").length}</span></div><div><b>03</b><strong>Tutor</strong><span>{staff.filter(p=>p.role==="tutor").length}</span></div><div><b>04</b><strong>Profesor</strong><span>{staff.filter(p=>p.role==="teacher").length}</span></div><div><b>05</b><strong>Alumno</strong><span>{studentCount}</span></div></div><section class="game-panel directory"><span>{staff.length+studentCount} REGISTROS</span><h2>DIRECTORIO INSTITUCIONAL</h2><div class="table-head"><b>PERSONA</b><b>ROL</b><b>ALCANCE</b><b>ESTADO</b><b>ACCION</b></div>{staff.map(person=><div class="table-row searchable"><strong>{person.full_name}<small>{person.email}</small></strong><span>{person.role}</span><span>{person.scope_label}</span><i>{person.status}</i><div class="row-actions"><button class="btn-edit" data-edit-staff data-id={person.id} data-full={person.full_name} data-email={person.email??""} data-role={person.role} data-scope={person.scope_label??""} data-status={person.status??"active"}>EDITAR</button><form method="post" action="/api/recursos" class="inline"><input type="hidden" name="action" value="delete_staff"/><input type="hidden" name="id" value={person.id}/><button class="btn-del" onclick="return confirm('Seguro de eliminar a esta persona?')">ELIMINAR</button></form></div></div>)}{students.slice(0,12).map(student=><div class="table-row searchable"><strong>{student.full_name}<small>{student.email??"Cuenta administrada"}</small></strong><span>Alumno</span><span>{sections.find(s=>s.id===student.section_id)?.display_name??"Sin seccion"}</span><i>{student.status}</i><div class="row-actions"><button class="btn-edit" data-edit-student data-id={student.id} data-full={student.full_name} data-email={student.email??""} data-section={student.section_id??""}>EDITAR</button><form method="post" action="/api/recursos" class="inline"><input type="hidden" name="action" value="delete_student"/><input type="hidden" name="id" value={student.id}/><button class="btn-del" onclick="return confirm('Seguro de eliminar a este alumno?')">ELIMINAR</button></form></div></div>)}</section></>}

		{view === "materiales" && <><div class="command-title"><div><span>LABORATORIO DE CONTENIDO</span><h1>MATERIALES E IA DOCENTE</h1><p>Carga archivos. La IA propone preguntas y el docente revisa.</p></div>{effectivePlan.aiCredits>0?<button class="command-btn" data-open-dialog="material-dialog">SUBIR ARCHIVOS</button>:<a class="command-btn" href="/planes">HABILITAR IA</a>}</div><button class="upload-zone" data-open-dialog="material-dialog"><span>PDF - PPTX - DOCX - TXT - PNG - JPG</span><strong>SELECCIONA MATERIAL DE CLASE</strong><small>Maximo 20 MB - espacio privado del colegio</small><b>EXPLORAR EQUIPO</b></button><div class="process-track">{["RECIBIDO","EXTRACCION","GENERACION IA","REVISION","APROBADO"].map((step,i)=><div><b>{String(i+1).padStart(2,"0")}</b><span>{step}</span></div>)}</div><section class="game-panel file-list"><span>{materials.length} ARCHIVOS</span><h2>MATERIALES RECIENTES</h2>{materials.map(material=><div class="searchable"><b>{String(material.file_type).toUpperCase()}</b><strong>{material.title}<small>{relationName(material.subjects)??"Sin materia"} - {material.file_name??"Registro manual"}</small></strong><i>{material.processing_status}</i><span>{questions.filter(q=>relationName(q.subjects)===relationName(material.subjects)).length} PREGUNTAS</span><div class="row-actions"><button data-detail-title={material.title} data-detail-body={`Estado ${material.processing_status}.`}>ABRIR</button><form method="post" action="/api/recursos" class="inline"><input type="hidden" name="action" value="delete_material"/><input type="hidden" name="id" value={material.id}/><button class="btn-del" onclick="return confirm('Eliminar este material y sus preguntas?')">ELIMINAR</button></form></div></div>)}</section></>}

		{view === "preguntas" && <><div class="command-title"><div><span>CONTROL PEDAGOGICO</span><h1>BANCO DE PREGUNTAS</h1><p>Solo las aprobadas pueden poblar nodos del grafo.</p></div><button class="command-btn" data-open-dialog="question-dialog">ANADIR PREGUNTA</button></div><div class="role-counts question-counts"><div><strong>{questionCount}</strong><span>TOTALES</span></div><div><strong>{approvedCount}</strong><span>APROBADAS</span></div><div><strong>{reviewCount}</strong><span>EN COLA</span></div><div><strong>05</strong><span>POR NODO</span></div></div><section class="game-panel question-list"><span>COLA DOCENTE</span><h2>PREGUNTAS POR REVISAR</h2>{questions.slice(0,20).map((question,i)=><article class="searchable"><b>Q-{String(i+1).padStart(3,"0")}</b><i>{relationName(question.subjects)??"General"}</i><strong>{question.question}</strong><small>{question.status}</small><div class="row-actions">{question.status!=="approved"?<form method="post" action="/api/recursos" class="inline"><input type="hidden" name="action" value="approve_question"/><input type="hidden" name="question_id" value={question.id}/><button>REVISAR Y APROBAR</button></form>:<span>APROBADA</span>}<button class="btn-edit" data-edit-question data-id={question.id} data-subject={question.subject_id??""} data-question={question.question} data-options={JSON.stringify(question.options??[])} data-correct={question.correct_index??0} data-status={question.status}>EDITAR</button><form method="post" action="/api/recursos" class="inline"><input type="hidden" name="action" value="delete_question"/><input type="hidden" name="id" value={question.id}/><button class="btn-del" onclick="return confirm('Eliminar esta pregunta?')">ELIMINAR</button></form></div></article>)}</section></>}

		{view === "tareas" && <><div class="command-title"><div><span>GESTION DE APRENDIZAJE</span><h1>TAREAS</h1><p>Alternativas, respuesta escrita o entrega de documentos.</p></div><button class="command-btn" data-open-dialog="assignment-dialog">CREAR TAREA</button></div><div class="card-grid">{assignments.map(task=><article class="assignment-card searchable"><div><span>{fmtDate(task.due_at)}</span><i>{task.status}</i></div><b>{relationName(task.subjects)??"General"}</b><h2>{task.title}</h2><p>{relationName(task.sections)??"Todas"} - {task.delivery_type}</p><strong>{task.xp_reward} XP</strong><div class="row-actions"><button class="btn-edit" data-edit-assignment data-id={task.id} data-title={task.title} data-section={task.section_id??""} data-subject={task.subject_id??""} data-type={task.delivery_type} data-due={task.due_at??""} data-xp={task.xp_reward??80} data-status={task.status}>EDITAR</button><form method="post" action="/api/recursos" class="inline"><input type="hidden" name="action" value="delete_assignment"/><input type="hidden" name="id" value={task.id}/><button class="btn-del" onclick="return confirm('Eliminar esta tarea?')">ELIMINAR</button></form></div></article>)}</div></>}

		{view === "batallas" && <><div class="command-title"><div><span>ARENA ESTRATEGICA</span><h1>BATALLAS Y TORNEOS</h1><p>Enfrentamientos por turnos, rutas conectadas y captura por tiempo.</p></div><div class="command-actions"><a class="command-btn ghost" href="/#inicio">ABRIR DEMO</a><button class="command-btn" data-open-dialog="battle-dialog">PROGRAMAR BATALLA</button></div></div>{liveBattle&&<section class="live-arena"><div><span>EN VIVO - POR TURNOS</span><h2>{liveBattle.opponent_a} VS {liveBattle.opponent_b}</h2><p>{liveBattle.graph_layers} capas - {liveBattle.nodes_per_layer} nodos por capa</p></div><div class="mini-graph"><b class="red-base">R</b><i></i><i></i><i></i><strong class="purple-base">M</strong></div><a href="/#inicio">ENTRAR</a></section>}<div class="card-grid">{battles.map(battle=><article class="battle-card searchable"><span>{battle.status}</span><h2>{battle.title}</h2><p>{battle.opponent_a} <b>VS</b> {battle.opponent_b}</p><small>{fmtDate(battle.scheduled_at)} - {battle.battle_type}</small><div class="row-actions"><button class="btn-edit" data-edit-battle data-id={battle.id} data-title={battle.title} data-oppa={battle.opponent_a} data-oppb={battle.opponent_b} data-when={battle.scheduled_at??""} data-status={battle.status}>EDITAR</button><form method="post" action="/api/recursos" class="inline"><input type="hidden" name="action" value="delete_battle"/><input type="hidden" name="id" value={battle.id}/><button class="btn-del" onclick="return confirm('Eliminar esta batalla?')">ELIMINAR</button></form></div></article>)}</div></>}

		{view === "progreso" && <><div class="command-title"><div><span>SISTEMA DE PROGRESO</span><h1>RANGOS, CLANES Y XP</h1><p>Define rangos institucionales y organiza clanes.</p></div><button class="command-btn" data-open-dialog="rank-dialog">NUEVO RANGO</button></div><div class="rank-track">{ranks.map(rank=><article><b>R{rank.position}</b><strong>{rank.name}</strong><span>{rank.min_xp.toLocaleString("es-PE")} XP</span></article>)}</div><div class="dashboard-grid two"><section class="game-panel clan-list"><span>CLANES ACTIVOS</span><h2>CLASIFICACION DE CLANES</h2>{clans.map((clan,i)=><div class="searchable"><b>{String(i+1).padStart(2,"0")}</b><i style={`--clan:${clan.color}`}></i><strong>{clan.name}<small>{sections.find(s=>s.id===clan.section_id)?.display_name}</small></strong><span>{(8420-i*610).toLocaleString("es-PE")} XP</span></div>)}</section><section class="game-panel xp-source"><span>REGLAS</span><h2>FUENTES DE XP</h2><strong>{settings.rank_rules?.xp_per_correct_answer??10}<small>Respuesta correcta</small></strong><strong>{settings.rank_rules?.xp_per_task??20}<small>Tarea completada</small></strong><strong>+25<small>Conquista de nodo</small></strong></section></div></>}

		{view === "auditoria" && <><div class="command-title"><div><span>TRAZABILIDAD</span><h1>ACTIVIDAD Y AUDITORIA</h1><p>Cambios sensibles, publicaciones, accesos y moderacion.</p></div><a class="command-btn" href="/api/auditoria">EXPORTAR REGISTRO</a></div><section class="game-panel audit-list"><span>HOY</span><h2>REGISTRO INSTITUCIONAL</h2>{audits.map(log=><div class="searchable"><time>{fmtDate(log.created_at)}</time><strong>{log.actor_name}</strong><p>{log.action}</p><span>{log.target_label}</span><button data-detail-title="Detalle de auditoria" data-detail-body={`${log.actor_name}: ${log.action}. ${log.target_label??""}`}>DETALLE</button></div>)}</section></>}
		</main>
	</div>
</section>

<dialog class="portal-dialog" id="section-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="section"/><header><div><span>NUEVA ESTRUCTURA</span><h2>Crear seccion</h2></div><button type="button" data-close-dialog>X</button></header><label>Nivel<select name="level"><option>Primaria</option><option>Secundaria</option></select></label><label>Grado<input name="grade" required placeholder="5"/></label><label>Seccion<input name="section_label" required placeholder="A"/></label><label>Tutor<input name="tutor_name" placeholder="Nombre del tutor"/></label><button class="command-btn" type="submit">CREAR Y CONFIGURAR</button></form></dialog>
<dialog class="portal-dialog" id="subject-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="subject"/><header><div><span>NUEVO NODO</span><h2>Crear materia</h2></div><button type="button" data-close-dialog>X</button></header><label>Nombre<input name="name" required placeholder="Ingles"/></label><label>Codigo<input name="icon_code" required maxlength="3" placeholder="ING"/></label><label>Color<input name="color" type="color" value="#e6b84d"/></label><button class="command-btn" type="submit">CREAR Y ASIGNAR</button></form></dialog>
<dialog class="portal-dialog" id="person-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" id="person-action" value="student"/><header><div><span>NUEVA IDENTIDAD</span><h2>Crear usuario</h2></div><button type="button" data-close-dialog>X</button></header><label>Tipo<select id="person-type" name="role"><option value="student">Alumno</option><option value="teacher">Profesor</option><option value="tutor">Tutor</option><option value="coordinator">Coordinador</option><option value="subdirector">Subdirector</option><option value="director">Director</option></select></label><label>Nombre<input name="full_name" required/></label><label>Correo<input name="email" type="email"/></label><label data-student-field>Seccion<select name="section_id"><option value="">Selecciona</option>{sections.map(section=><option value={section.id}>{section.display_name}</option>)}</select></label><label data-staff-field hidden>Alcance<input name="scope_label" placeholder="Materia, seccion o colegio"/></label><label class="check-label" data-student-field><input name="focus_mode" type="checkbox"/> Activar modo de concentracion</label><button class="command-btn" type="submit">CREAR PERFIL</button></form></dialog>
<dialog class="portal-dialog" id="import-dialog"><form><header><div><span>CARGA MASIVA</span><h2>Importar usuarios</h2></div><button type="button" data-close-dialog>X</button></header><label>Archivo CSV<input type="file" accept=".csv"/></label><small>Columnas: nombre, correo, rol y seccion.</small><button class="command-btn" type="button" data-demo-action="CSV validado. Listo para importar perfiles.">VALIDAR ARCHIVO</button></form></dialog>
<dialog class="portal-dialog" id="material-dialog"><form method="post" action="/api/recursos" enctype="multipart/form-data"><input type="hidden" name="action" value="material"/><header><div><span>NUEVO CONTENIDO</span><h2>Subir material</h2></div><button type="button" data-close-dialog>X</button></header><label>Titulo<input name="title" required/></label><label>Materia<select name="subject_id" required><option value="">Selecciona</option>{subjects.map(subject=><option value={subject.id}>{subject.name}</option>)}</select></label><label>Archivo<input name="file" type="file" accept=".pdf,.ppt,.pptx,.doc,.docx,.txt,.png,.jpg,.jpeg,.webp"/></label><small>La carga genera preguntas de muestra para revision.</small><button class="command-btn" type="submit">PROCESAR MATERIAL</button></form></dialog>
<dialog class="portal-dialog" id="question-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="question"/><header><div><span>BANCO MANUAL</span><h2>Anadir pregunta</h2></div><button type="button" data-close-dialog>X</button></header><label>Materia<select name="subject_id" required>{subjects.map(subject=><option value={subject.id}>{subject.name}</option>)}</select></label><label>Pregunta<input name="question" required minlength="8"/></label>{[0,1,2,3].map(i=><label>Opcion {String.fromCharCode(65+i)}<input name={`option_${i}`} required/></label>)}<label>Correcta<select name="correct_index"><option value="0">A</option><option value="1">B</option><option value="2">C</option><option value="3">D</option></select></label><button class="command-btn" type="submit">GUARDAR PREGUNTA</button></form></dialog>
<dialog class="portal-dialog" id="assignment-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="assignment"/><header><div><span>NUEVA MISION</span><h2>Crear tarea</h2></div><button type="button" data-close-dialog>X</button></header><label>Titulo<input name="title" required/></label><label>Seccion<select name="section_id" required>{sections.map(section=><option value={section.id}>{section.display_name}</option>)}</select></label><label>Materia<select name="subject_id" required>{subjects.map(subject=><option value={subject.id}>{subject.name}</option>)}</select></label><label>Tipo<select name="delivery_type"><option value="quiz">Alternativas</option><option value="written">Respuesta escrita</option><option value="document">Documento</option></select></label><label>Entrega<input name="due_at" type="datetime-local"/></label><label>XP<input name="xp_reward" type="number" min="0" max="10000" value="80"/></label><button class="command-btn" type="submit">PROGRAMAR TAREA</button></form></dialog>
<dialog class="portal-dialog" id="battle-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="battle"/><header><div><span>NUEVA CONTIENDA</span><h2>Programar batalla</h2></div><button type="button" data-close-dialog>X</button></header><label>Nombre<input name="title" required/></label><label>Tipo<select name="battle_type"><option value="student_vs_bot">Alumno vs bot</option><option value="student_vs_student">Alumno vs alumno</option><option value="section_vs_section">Seccion vs seccion</option><option value="tournament">Torneo</option></select></label><label>Equipo rojo<input name="opponent_a" required/></label><label>Equipo morado<input name="opponent_b" required/></label><label>Fecha<input name="scheduled_at" type="datetime-local"/></label><div class="dialog-columns"><label>Capas<input name="graph_layers" type="number" min="4" max="7" value="4"/></label><label>Nodos<input name="nodes_per_layer" type="number" min="3" max="4" value="4"/></label></div><button class="command-btn" type="submit">PROGRAMAR BATALLA</button></form></dialog>
<dialog class="portal-dialog" id="rank-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="rank"/><header><div><span>NUEVO ASCENSO</span><h2>Crear rango</h2></div><button type="button" data-close-dialog>X</button></header><label>Nombre<input name="name" required placeholder="Guardian"/></label><label>XP minima<input name="min_xp" type="number" min="0" value="7500"/></label><button class="command-btn" type="submit">CREAR RANGO</button></form></dialog>
<dialog class="portal-dialog" id="edit-staff-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="update_staff"/><input type="hidden" name="id"/><header><div><span>EDITAR PERSONA</span><h2>Miembro del equipo</h2></div><button type="button" data-close-dialog>X</button></header><label>Nombre<input name="full_name" required/></label><label>Correo<input name="email" type="email"/></label><label>Rol<select name="role"><option value="director">Director</option><option value="subdirector">Subdirector</option><option value="coordinator">Coordinador</option><option value="tutor">Tutor</option><option value="teacher">Profesor</option></select></label><label>Alcance<input name="scope_label" placeholder="Materia, seccion o colegio"/></label><label>Estado<select name="status"><option value="active">Activo</option><option value="invited">Invitado</option><option value="suspended">Suspendido</option></select></label><button class="command-btn" type="submit">GUARDAR CAMBIOS</button></form></dialog>
<dialog class="portal-dialog" id="edit-student-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="update_student"/><input type="hidden" name="id"/><header><div><span>EDITAR ALUMNO</span><h2>Perfil de estudiante</h2></div><button type="button" data-close-dialog>X</button></header><label>Nombre<input name="full_name" required/></label><label>Correo<input name="email" type="email"/></label><label>Seccion<select name="section_id"><option value="">Sin seccion</option>{sections.map(section=><option value={section.id}>{section.display_name}</option>)}</select></label><button class="command-btn" type="submit">GUARDAR CAMBIOS</button></form></dialog>
<dialog class="portal-dialog" id="edit-question-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="update_question"/><input type="hidden" name="id"/><header><div><span>EDITAR PREGUNTA</span><h2>Banco de preguntas</h2></div><button type="button" data-close-dialog>X</button></header><label>Materia<select name="subject_id">{subjects.map(subject=><option value={subject.id}>{subject.name}</option>)}</select></label><label>Pregunta<input name="question" required minlength="8"/></label>{[0,1,2,3].map(i=><label>Opcion {String.fromCharCode(65+i)}<input name={`option_${i}`} required/></label>)}<label>Correcta<select name="correct_index"><option value="0">A</option><option value="1">B</option><option value="2">C</option><option value="3">D</option></select></label><label>Estado<select name="status"><option value="review">En revision</option><option value="approved">Aprobada</option></select></label><button class="command-btn" type="submit">GUARDAR CAMBIOS</button></form></dialog>
<dialog class="portal-dialog" id="edit-assignment-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="update_assignment"/><input type="hidden" name="id"/><header><div><span>EDITAR TAREA</span><h2>Tarea programada</h2></div><button type="button" data-close-dialog>X</button></header><label>Titulo<input name="title" required/></label><label>Seccion<select name="section_id">{sections.map(section=><option value={section.id}>{section.display_name}</option>)}</select></label><label>Materia<select name="subject_id">{subjects.map(subject=><option value={subject.id}>{subject.name}</option>)}</select></label><label>Entrega<input name="due_at" type="datetime-local"/></label><label>XP<input name="xp_reward" type="number" min="0" max="10000"/></label><label>Estado<select name="status"><option value="scheduled">Programada</option><option value="published">Publicada</option><option value="closed">Cerrada</option></select></label><button class="command-btn" type="submit">GUARDAR CAMBIOS</button></form></dialog>
<dialog class="portal-dialog" id="edit-battle-dialog"><form method="post" action="/api/recursos"><input type="hidden" name="action" value="update_battle"/><input type="hidden" name="id"/><header><div><span>EDITAR BATALLA</span><h2>Contienda programada</h2></div><button type="button" data-close-dialog>X</button></header><label>Nombre<input name="title" required/></label><label>Equipo rojo<input name="opponent_a" required/></label><label>Equipo morado<input name="opponent_b" required/></label><label>Fecha<input name="scheduled_at" type="datetime-local"/></label><label>Estado<select name="status"><option value="scheduled">Programada</option><option value="live">En vivo</option><option value="finished">Finalizada</option></select></label><button class="command-btn" type="submit">GUARDAR CAMBIOS</button></form></dialog>
<dialog class="portal-dialog detail-dialog" id="detail-dialog"><form method="dialog"><header><div><span>DETALLE</span><h2 id="detail-title">Detalle</h2></div><button data-close-dialog>X</button></header><p id="detail-body"></p><button class="command-btn" value="close">CERRAR</button></form></dialog><div class="command-toast" id="command-toast" role="status" hidden></div>
</PortalLayout>
<script>
const openDialog=(id:string)=>(document.getElementById(id) as HTMLDialogElement|null)?.showModal();
document.querySelectorAll<HTMLElement>("[data-open-dialog]").forEach(b=>b.addEventListener("click",()=>openDialog(b.dataset.openDialog??"")));
document.querySelectorAll<HTMLButtonElement>("[data-close-dialog]").forEach(b=>b.addEventListener("click",()=>b.closest("dialog")?.close()));
document.querySelectorAll<HTMLDialogElement>("dialog").forEach(d=>d.addEventListener("click",e=>{if(e.target===d)d.close();}));
document.querySelectorAll<HTMLElement>("[data-detail-title]").forEach(b=>b.addEventListener("click",()=>{const t=document.getElementById("detail-title"),p=document.getElementById("detail-body");if(t)t.textContent=b.dataset.detailTitle??"Detalle";if(p)p.textContent=b.dataset.detailBody??"";openDialog("detail-dialog");}));
const personType=document.getElementById("person-type") as HTMLSelectElement|null; const syncPerson=()=>{const student=personType?.value==="student";const action=document.getElementById("person-action") as HTMLInputElement|null;if(action)action.value=student?"student":"staff";document.querySelectorAll<HTMLElement>("[data-student-field]").forEach(e=>e.hidden=!student);document.querySelectorAll<HTMLElement>("[data-staff-field]").forEach(e=>e.hidden=Boolean(student));};personType?.addEventListener("change",syncPerson);syncPerson();
const search=document.getElementById("command-search") as HTMLInputElement|null;search?.addEventListener("input",()=>{const term=search.value.trim().toLowerCase();document.querySelectorAll<HTMLElement>(".searchable").forEach(item=>item.hidden=Boolean(term&&!item.textContent?.toLowerCase().includes(term)));});
const toast=document.getElementById("command-toast") as HTMLElement|null;document.querySelectorAll<HTMLElement>("[data-demo-action]").forEach(b=>b.addEventListener("click",()=>{if(!toast)return;toast.textContent=b.dataset.demoAction??"Accion completada.";toast.hidden=false;setTimeout(()=>toast.hidden=true,3200);}));
const role=document.getElementById("role-view") as HTMLSelectElement|null;role?.addEventListener("change",()=>{if(!toast)return;toast.textContent=`Vista previa: ${role.value}. Los permisos reales se aplican al iniciar sesion.`;toast.hidden=false;setTimeout(()=>toast.hidden=true,3200);});
const setVal=(dlg:string,id:string,val:unknown)=>{const el=document.querySelector(`#${dlg} [name="${id}"]`)as HTMLInputElement|HTMLSelectElement|null;if(el&&val!==undefined&&val!==null)el.value=String(val);};
document.querySelectorAll<HTMLElement>("[data-edit-staff]").forEach(b=>b.addEventListener("click",()=>{const d=b.dataset;setVal("edit-staff-dialog","id",d.id);setVal("edit-staff-dialog","full_name",d.full);setVal("edit-staff-dialog","email",d.email);setVal("edit-staff-dialog","role",d.role);setVal("edit-staff-dialog","scope_label",d.scope);setVal("edit-staff-dialog","status",d.status);openDialog("edit-staff-dialog");}));
document.querySelectorAll<HTMLElement>("[data-edit-student]").forEach(b=>b.addEventListener("click",()=>{const d=b.dataset;setVal("edit-student-dialog","id",d.id);setVal("edit-student-dialog","full_name",d.full);setVal("edit-student-dialog","email",d.email);setVal("edit-student-dialog","section_id",d.section);openDialog("edit-student-dialog");}));
document.querySelectorAll<HTMLElement>("[data-edit-question]").forEach(b=>b.addEventListener("click",()=>{const d=b.dataset;let options:string[]=[];try{options=JSON.parse(d.options??"[]");}catch{}setVal("edit-question-dialog","id",d.id);setVal("edit-question-dialog","subject_id",d.subject);setVal("edit-question-dialog","question",d.question);(options.slice(0,4)).forEach((opt,i)=>setVal("edit-question-dialog",`option_${i}`,opt));setVal("edit-question-dialog","correct_index",String(d.correct??"0"));setVal("edit-question-dialog","status",d.status);openDialog("edit-question-dialog");}));
document.querySelectorAll<HTMLElement>("[data-edit-assignment]").forEach(b=>b.addEventListener("click",()=>{const d=b.dataset;setVal("edit-assignment-dialog","id",d.id);setVal("edit-assignment-dialog","title",d.title);setVal("edit-assignment-dialog","section_id",d.section);setVal("edit-assignment-dialog","subject_id",d.subject);setVal("edit-assignment-dialog","delivery_type",d.type);setVal("edit-assignment-dialog","due_at",d.due&&d.due.length>=16?(d.due.slice(0,16)):"");setVal("edit-assignment-dialog","xp_reward",d.xp);setVal("edit-assignment-dialog","status",d.status);openDialog("edit-assignment-dialog");}));
document.querySelectorAll<HTMLElement>("[data-edit-battle]").forEach(b=>b.addEventListener("click",()=>{const d=b.dataset;setVal("edit-battle-dialog","id",d.id);setVal("edit-battle-dialog","title",d.title);setVal("edit-battle-dialog","opponent_a",d.oppa);setVal("edit-battle-dialog","opponent_b",d.oppb);setVal("edit-battle-dialog","scheduled_at",d.when&&d.when.length>=16?(d.when.slice(0,16)):"");setVal("edit-battle-dialog","status",d.status);openDialog("edit-battle-dialog");}));
</script>
