---
import PortalLayout from "../layouts/PortalLayout.astro";
import { getPlan } from "../lib/plans";
import { hasSupabaseConfig } from "../lib/supabase";

const plan = getPlan(Astro.url.searchParams.get("plan"));
const authReady = hasSupabaseConfig();
---

<PortalLayout
	title="Crear cuenta institucional | BattleGraph"
	description="Cree una cuenta institucional de BattleGraph con validación segura de Google."
>
	<section class="auth-shell">
		<div class="auth-copy">
			<div class="portal-kicker">REGISTRO INSTITUCIONAL / PASO 02</div>
			<h1>Funda tu<br /><span>academia</span></h1>
			<p>La cuenta de Google identifica al propietario inicial. BattleGraph crea automáticamente un colegio demostrativo editable con secciones, materias, clanes, estudiantes, materiales y reglas de batalla.</p>

			<div class="auth-steps" aria-label="Proceso de registro">
				<div class="active"><b>01</b><span>Elegir plan</span></div>
				<div class="active"><b>02</b><span>Validar identidad</span></div>
				<div><b>03</b><span>Configurar colegio</span></div>
			</div>
		</div>

		<div class="auth-card">
			<div class="auth-plan-line">
				<span>PLAN SELECCIONADO</span>
				<a href="/planes">Cambiar</a>
			</div>
			<div class="auth-plan">
				<div><strong>{plan.name}</strong><small>{plan.studentLimit.toLocaleString("es-PE")} estudiantes incluidos</small></div>
				<b>{plan.price}</b>
			</div>
			{plan.trialDays > 0 && (
				<div class="trial-callout">
					<strong>7 días con el nivel máximo</strong>
					<span>Prueba IA, carga de archivos, asistentes, resúmenes y configuración Red Educativa. Después continuarás gratis con hasta 30 alumnos.</span>
				</div>
			)}

			<h2>Crea tu acceso</h2>
						<p class="auth-helper">Elige tu rol. La cuenta de Google identifica a la persona y queda vinculada al colegio para su trazabilidad.</p>

						<div class="auth-role-select" id="auth-role-select">
							<label class="auth-role-card active" data-role="director">
								<input type="radio" name="role" value="director" checked />
								<strong>Director</strong>
								<small>Fundo el colegio</small>
							</label>
							<label class="auth-role-card" data-role="teacher">
								<input type="radio" name="role" value="teacher" />
								<strong>Profesor</strong>
								<small>Me uno a un colegio</small>
							</label>
							<label class="auth-role-card" data-role="student">
								<input type="radio" name="role" value="student" />
								<strong>Alumno</strong>
								<small>Me uno a un colegio</small>
							</label>
						</div>

						<label class="auth-code-field hidden" id="school-code-field">
							<span>Código del colegio</span>
							<input id="school-code" name="school_code" placeholder="EJ: BG-7A2K" maxlength="30" autocomplete="off" />
							<small>Pide el código a tu director o profesor. Sirve para vincular tu cuenta al colegio.</small>
						</label>

						{authReady ? (
							<a class="google-button" id="google-join" href={`/auth/google?plan=${plan.slug}&role=director`}>
								<span class="google-mark" aria-hidden="true">G</span>
								Continuar con Google
							</a>
						) : (
							<div class="auth-config-warning" role="status">
								<strong>Conexión pendiente</strong>
								<span>El formulario está listo. Falta configurar las variables de Supabase en Vercel para habilitar Google.</span>
							</div>
						)}

			<div class="auth-security">
				<span class="security-glyph" aria-hidden="true"></span>
				<div><strong>Acceso protegido</strong><small>OAuth 2.0 con PKCE, sesión segura y permisos por institución.</small></div>
			</div>

			<p class="auth-legal">Al continuar aceptas los términos de uso institucional y la política de tratamiento de datos. Las cuentas de menores son creadas y administradas por el colegio.</p>
			<p class="auth-existing">¿Ya configuraste BattleGraph? <a href="/iniciar-sesion">Inicia sesión</a></p>
					</div>
				</section>

				<script>
					// Selector de rol + código de colegio en el registro
					const roleCards = document.querySelectorAll("[data-role]");
					const codeField = document.getElementById("school-code-field");
					const codeInput = document.getElementById("school-code");
					const googleJoin = document.getElementById("google-join");
					const planSlug = new URLSearchParams(location.search).get("plan") ?? "explorador";

					function updateJoin() {
						const active = [...roleCards].find((c) => c.classList.contains("active"));
						const role = active ? active.dataset.role : "director";
						let href = `/auth/google?plan=${planSlug}&role=${role}`;
						if (role !== "director") {
							const code = (codeInput?.value ?? "").trim().toUpperCase();
							codeField?.classList.remove("hidden");
							if (code.length >= 3) href += `&school_code=${encodeURIComponent(code)}`;
						} else {
							codeField?.classList.add("hidden");
						}
						if (googleJoin) googleJoin.href = href;
					}

					roleCards.forEach((card) => {
						card.addEventListener("click", () => {
							roleCards.forEach((c) => c.classList.remove("active"));
							card.classList.add("active");
							card.querySelector("input") && (card.querySelector("input").checked = true);
							updateJoin();
						});
					});
					codeInput?.addEventListener("input", updateJoin);
					updateJoin();
				</script>
			</PortalLayout>
