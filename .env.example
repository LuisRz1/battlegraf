SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Solo se necesita para tareas administrativas futuras. Nunca exponga esta clave al navegador.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Conexión directa usada únicamente por el runner de migraciones.
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST:5432/postgres

# URL publica sin barra final. En local puede usar http://localhost:4321.
PUBLIC_SITE_URL=http://localhost:4321
